@model ChangeNameDto

<div class="profile-settings-field-content">

    <label asp-for="NewName"
           class="form-label">
        <span lang="en">Display Name</span>
        <span lang="ar">الاسم المعروض</span>
    </label>

    <p class="text-grey">
        <span lang="en">The name displayed on your account</span>
        <span lang="ar">الاسم المعروض على حسابك</span>
    </p>

</div>

<div class="profile-settings-field-control">

    <div class="profile-settings-input-wrapper">

        <input asp-for="NewName"
               class="form-input"/>

        <span asp-validation-for="NewName"
              class="text-red">
        </span>
        
    </div>

    <button type="submit"
            class="button button-blue-back">
        <span lang="en">Save</span>
        <span lang="ar">حفظ</span>
    </button>

</div>