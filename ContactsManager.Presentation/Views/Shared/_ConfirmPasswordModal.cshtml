@model ConfirmPasswordViewModel

<div class="modal-overlay" id="confirmPasswordModal">

    <div class="confirm-modal">

        <div class="confirm-modal-header">
            <h2 id="confirmPasswordTitle">
                @Model.Title
            </h2>

            <button type="button"
                    class="modal-close"
                    onclick="closeConfirmPasswordModal()">
                &times;
            </button>
        </div>

        <form id="confirmPasswordForm"
              asp-controller="Account"
              asp-action="ConfirmPassword"
              method="post">

            <div class="confirm-modal-body">

                <p id="confirmPasswordMessage">
                    @Model.Message
                </p>
                
                <br>

                <div class="form-group">

                    <label asp-for="Password">
                        <span lang="en">Password</span><span lang="ar">كلمة المرور</span>
                    </label>

                    <input asp-for="Password"
                           class="form-control">

                    <span asp-validation-for="Password"
                          class="validation-error"
                          id="confirmPasswordError">
                    </span>

                </div>

                <input asp-for="Action"
                       type="hidden"
                       id="sensitiveAction" />
                
            </div>

            <div class="confirm-modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeConfirmPasswordModal()">
                    <span lang="en">Cancel</span>
                    <span lang="ar">إلغاء</span>
                </button>

                <button type="submit"
                        class="btn btn-primary"
                        id="confirmPasswordSubmit">
                    @Model.SubmitText
                </button>

            </div>

        </form>

    </div>

</div>