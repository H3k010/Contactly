@model SettingsViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewBag.Title = "Settings";
    ViewBag.CurrentUrl = "~/settings";
}

<div class="settings-page">

    <div class="settings-header">

        <h1><span lang="en">Settings</span><span lang="ar">الإعدادات</span></h1>

        <p class="text-grey">
            <span
                lang="en">@(Model.IsAuthenticated ? "Manage your account and application preferences" : "Manage your application preferences")</span>
            <span lang="ar">@(Model.IsAuthenticated ? "إدارة حسابك وتفضيلات التطبيق" : "إدارة تفضيلات التطبيق")</span>
        </p>

    </div>


    <!-- Account -->
    @if (Model.IsAuthenticated)
    {
        <section class="settings-section">

            <div class="settings-section-header">
                <span lang="en">ACCOUNT</span><span lang="ar">الحساب</span>
            </div>


            <div class="settings-item">

                <div class="settings-item-content">

                    <h3><span lang="en">Profile</span><span lang="ar">الملف الشخصي</span></h3>

                    <p class="text-grey">
                        <span lang="en">Manage your personal information</span><span
                            lang="ar">إدارة معلوماتك الشخصية</span>
                    </p>

                    <br>

                    <p>
                        <span style=" font-weight: bold; margin-right: 50px; color: #94a3b8"><span lang="en">Name</span><span
                                lang="ar">الاسم</span></span>
                        <span class="text-blue">@Model.DisplayName</span>
                    </p>

                    <br>

                    <p>
                        <span style=" font-weight: bold; margin-right: 50px; color: #94a3b8"><span
                                lang="en">Email</span><span lang="ar">البريد الإلكتروني</span></span>
                        <span class="text-blue">@Model.Email</span>
                    </p>

                </div>

                <div class="settings-item-action">

                    <a asp-controller="Account"
                       asp-action="Profile-Settings"
                       class="button-link button-blue-back">
                        <span lang="en">Edit Profile</span>
                        <span lang="ar">تعديل الملف الشخصي</span>
                    </a>

                </div>

            </div>


            <div class="settings-divider"></div>


            <div class="settings-item">

                <div class="settings-item-content">

                    <h3><span lang="en">Password</span><span lang="ar">كلمة المرور</span></h3>

                    <p class="text-grey">
                        <span lang="en">Change your account password</span><span lang="ar">تغيير كلمة مرور حسابك</span>
                    </p>

                </div>

                @if (TempData["PasswordChanged"] as bool? == true)
                {
                    <div class="text-green">
                        <span lang="en">Your password has been changed successfully!</span>
                        <span lang="ar">تم تغيير كلمة المرور بنجاح!</span>
                    </div>
                }

                <div class="settings-item-action">

                    <button type="button"
                            data-action="Change-Password"
                            data-title="@Localizer["ConfirmPasswordChange"]"
                            data-message="@Localizer["EnterPasswordToChangePassword"]"
                            data-submit-text="@Localizer["Continue"]"
                            data-url="@Url.Action("Change-Password", "Account")"
                            onclick="submitSensitiveForm(this)"
                            class="button button-blue-back">
                        @Localizer["ChangePassword"]
                    </button>

                </div>

            </div>

        </section>
    }

    <!-- Appearance -->
    <section class="settings-section">

        <div class="settings-section-header">
            <span lang="en">APPEARANCE</span><span lang="ar">المظهر</span>
        </div>


        <div class="settings-item settings-item-stack">

            <div class="settings-item-content">

                <h3><span lang="en">Theme</span><span lang="ar">الوضع</span></h3>

                <p class="text-grey">
                    <span lang="en">Choose how the application should look</span>
                    <span lang="ar">اختر كيف يجب أن يبدو التطبيق</span>
                </p>

            </div>

            <div class="theme-options">

                <label class="radio-option">

                    <input type="radio"
                           name="theme"
                           value="system"/>

                    <span lang="en">System</span>
                    <span lang="ar">النظام</span>

                </label>

                <label class="radio-option">

                    <input type="radio"
                           name="theme"
                           value="light"/>

                    <span lang="en">Light</span>
                    <span lang="ar">الفاتح</span>

                </label>

                <label class="radio-option">

                    <input type="radio"
                           name="theme"
                           value="dark"/>

                    <span lang="en">Dark</span>
                    <span lang="ar">الداكن</span>

                </label>
                
            </div>

        </div>

        <div class="settings-divider"></div>

        <div class="settings-item">

            <div class="settings-item-content">

                <h3><span lang="en">Language</span><span lang="ar">اللغة</span></h3>

                <label for="langSelect" class="text-grey">
                    <span lang="en">Choose your preferred language</span>
                    <span lang="ar">اختر لغتك المفضلة</span>
                </label>

            </div>

            <div class="settings-item-control">

                <select id="langSelect" class="settings-select"
                        name="language">

                    <option value="en" selected>
                        <span lang="en">English</span>
                        <span lang="ar">الإنجليزية</span>
                    </option>

                    <option value="ar">
                        <span lang="en">Arabic</span>
                        <span lang="ar">العربية</span>
                    </option>

                </select>

            </div>

        </div>

    </section>

    @if (Model.IsAuthenticated)
    {
        <!-- Danger Zone -->
        <section class="settings-section settings-danger">

            <div class="settings-section-header">
                <span lang="en">DANGER ZONE</span><span lang="ar">منطقة الخطر</span>
            </div>

            <div class="settings-item">

                <div class="settings-item-content">

                    <h3><span lang="en">Delete Account</span><span lang="ar">حذف الحساب</span></h3>

                    <p class="text-grey">
                        <span lang="en">Permanently delete your account and all associated contacts.</span>
                        <span lang="ar">احذف حسابك وجميع جهات الاتصال المرتبطة به نهائياً.</span>
                    </p>

                </div>

                @if (TempData["DeleteFailed"] as bool? == true)
                {
                    <span class="text-red">
                        <span lang="en">Failed to delete the account</span>
                        <span lang="ar">فشل في حذف الحساب</span>
                    </span>
                }

                <div class="settings-item-action">

                    <form asp-controller="Account"
                          asp-action="DeleteAccount"
                          method="post">
                        <button type="button"
                                data-action="DeleteAccount"
                                data-title="@Localizer["ConfirmAccountDeletion"]"
                                data-message="@Localizer["ConfirmAccountDeletionMessage"]"
                                data-submit-text="@Localizer["DeleteAccount"]"
                                onclick="submitSensitiveForm(this)"
                                class="button button-red-back">
                            @Localizer["DeleteAccount"]
                        </button>
                    </form>

                </div>

            </div>

        </section>
    }
    else
    {
        <section class="settings-section">

            <div class="settings-section-header">
                <span lang="en">ACCOUNT</span><span lang="ar">الحساب</span>
            </div>

            <div class="settings-item">

                <div class="settings-item-content text-center">

                    <h3><span lang="en">Sign in to access account settings and personalized preferences.</span><span
                            lang="ar">سجّل الدخول للوصول إلى إعدادات الحساب والتفضيلات المخصصة.</span></h3>

                </div>

            </div>
            <div class="settings-item-action text-center">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="button-link button-blue-back">
                    <span lang="en">Login</span>
                    <span lang="ar">تسجيل الدخول</span>
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="button-link btn-secondary">
                    <span lang="en">Register</span>
                    <span lang="ar">التسجيل</span>
                </a>

            </div>
            <br>

        </section>
    }

</div>

<partial name="_ConfirmPasswordModal" model="Model.ConfirmPassword "/>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
