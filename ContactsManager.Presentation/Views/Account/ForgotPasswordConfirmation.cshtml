@{
    ViewBag.Title = "Forget Password";
}

<div class="form-container">

    @if (TempData["EmailSent"] as bool? == true)
    {
        <h3><span lang="en">Check Your Email</span>
            <span lang="ar">تحقق من بريدك الإلكتروني</span>
        </h3>
        <br>
        <p><span lang="en">If an account matches that email address, we have sent instructions to reset your password.</span> 
            <span lang="ar">إذا كان هناك حساب يطابق عنوان البريد الإلكتروني هذا، فقد أرسلنا تعليمات لإعادة تعيين كلمة المرور.</span>
        </p>
        <br>
        <br>
    }

    <div class="text-center">
        <a asp-controller="Account" asp-action="Login" class="button-link button-gray-back">Back to Login</a>
    </div>

</div>