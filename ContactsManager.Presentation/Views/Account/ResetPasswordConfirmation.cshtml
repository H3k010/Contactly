@{
    ViewBag.Title = "Password Reset Complete";
}

<div class="form-container">

    @if (TempData["PasswordReset"] as bool? == true)
    {
        <h3><span lang="en">Password Reset!</span>
            <span lang="ar">تم إعادة تعيين كلمة المرور!</span></h3>
        <br>
        <p><span lang="en">Your password has been successfully updated. You can now use your new password to sign into your account.</span>
            <span lang="ar">تم تحديث كلمة المرور بنجاح. يمكنك الآن استخدام كلمة المرور الجديدة لتسجيل الدخول إلى حسابك.</span>
        </p>
        <br>
        <br>
    }
    <div class="text-center">
        <a asp-controller="Account" asp-action="Login" class="button-link button-green-back">
            <span lang="en">Login</span>
            <span lang="ar">تسجيل الدخول</span>
        </a>
    </div>

</div>