@model ResetPasswordDto

@{
    ViewBag.Title = "Reset Password";
}

<div class="form-container">

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        
        <input hidden asp-for="Email"/>
        <input hidden asp-for="Token"/>
        
        @*NewPassword*@
        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="NewPassword" class="form-label pt">
                    <span lang="en">New Password</span>
                    <span lang="ar">كلمة المرور الجديدة</span>
                </label>
            </div>
            <div class="flex-1">
                <input asp-for="NewPassword" class="form-input"/>
                <span asp-validation-for="NewPassword" class="text-red"></span>
            </div>
        </div>

        @*ConfirmPassword*@
        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="ConfirmPassword" class="form-label pt">
                    <span lang="en">Confirm Password</span>
                    <span lang="ar">تأكيد كلمة المرور</span>
                </label>
            </div>
            <div class="flex-1">
                <input asp-for="ConfirmPassword" class="form-input"/>
                <span asp-validation-for="ConfirmPassword" class="text-red"></span>
            </div>
        </div>

        <div class="form-field flex">
            <div class="w-25"></div>
            <div class="flex-1">
                <button class="button button-green-back" type="submit">
                    <span lang="en">Change Password</span>
                    <span lang="ar">تغيير كلمة المرور</span>
                </button>
                <a asp-controller="Account" asp-action="Login"
                   class="button-link button-gray-back">
                    <span lang="en">Cancel</span>
                    <span lang="ar">إلغاء</span>
                </a>

                <div asp-validation-summary="ModelOnly" class="text-red"></div>
            </div>
        </div>

    </form>

    @section scripts{
        <partial name="_ValidationScriptsPartial"/>
    }

</div>