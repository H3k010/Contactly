@model ForgetPasswordDto

@{
    ViewBag.Title = "Forget Password";
}

<div class="form-container">

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        
        @*Email*@
        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="Email" class="form-label pt">
                    <span lang="en">Email</span>
                    <span lang="ar">البريد الإلكتروني</span>
                </label>
            </div>
            <div class="flex-1">
                <input asp-for="Email" class="form-input"/>
                <span asp-validation-for="Email" class="text-red"></span>
            </div>
        </div>

        <div class="form-field flex">
            <div class="w-25"></div>
            <div class="flex-1">
                <button class="button button-green-back" type="submit">
                    <span lang="en">Change Password</span>
                    <span lang="ar">تغيير كلمة المرور</span>
                </button>
                <a asp-controller="Account" asp-action="Login"
                   class="button-link button-gray-back">
                    <span lang="en">Back to Login</span>
                    <span lang="ar">العودة إلى تسجيل الدخول</span>
                </a>

                <div asp-validation-summary="ModelOnly" class="text-red"></div>
            </div>
        </div>

    </form>

    @section scripts{
        <partial name="_ValidationScriptsPartial"/>
    }

</div>