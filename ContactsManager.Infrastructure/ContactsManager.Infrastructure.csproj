<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ContactsManager.Application\ContactsManager.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.1.0" />
      <PackageReference Include="MailKit" Version="4.17.0" />
      <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.12" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="MySql.Data" Version="26.7.0" />
      <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\Services\ContactsService.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>ContactsService.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Services\ContactsService.ar.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>ContactsService.ar.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\LocalizedIdentityErrorDescriber.ar.resx">
        <LastGenOutput>LocalizedIdentityErrorDescriber.ar.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Services\Account\AccountService.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>AccountService.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Services\Account\AccountService.ar.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>AccountService.ar.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\LocalizedIdentityErrorDescriber.resx">
        <LastGenOutput>LocalizedIdentityErrorDescriber.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\Services\ContactsService.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>ContactsService.resx</DependentUpon>
      </Compile>
      <Compile Update="Resources\Services\ContactsService.ar.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>ContactsService.ar.resx</DependentUpon>
      </Compile>
      <Compile Update="Resources\Services\Account\AccountService.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>AccountService.resx</DependentUpon>
      </Compile>
      <Compile Update="Resources\Services\Account\AccountService.ar.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>AccountService.ar.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
